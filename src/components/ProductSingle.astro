---
interface Props {
  title: string;
  description: string;
  image: string;
  status: string;
  price?: string;
}

const { title, description, image, status, price = "" } = Astro.props;
---

<div class="product-card">
  <div class="product-card__thumb">
    <img src={image} alt={title} class="product-card__image" />
    <span class="product-card__badge">
      <i class="icon-tablet product-card__badge-icon" aria-hidden="true"></i>
      <span class="product-card__badge-text">{status}</span>
    </span>
  </div>
  <div class="product-card__content">
    <h2 class="product-card__title">{title}</h2>
    <p class="product-card__description">
      <strong>Ingredient:</strong>
      {description}
    </p>
    <p class="product-card__price">{price}</p>
  </div>
  <div class="product-card__link">
    <button
      type="button"
      class="theme-btn theme-btn__outline theme-btn__outline--primary"
      data-bs-toggle="modal"
      data-bs-target="#productDetailsModal"
    >
      Learn More
    </button>
    <button
      type="button"
      class="theme-btn theme-btn__primary"
      data-bs-toggle="offcanvas"
      data-bs-target="#productStartOffcanvas"
      aria-controls="productStartOffcanvas"
    >
      Add To Cart
    </button>
  </div>
</div>
