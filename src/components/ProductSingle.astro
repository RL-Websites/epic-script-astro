---
interface Props {
	title: string;
	description: string;
	image: string;
	status: string;
	price?: string;
}

const { title, description, image, status, price = "" } = Astro.props;
---

<div class="single-product">
	<div class="single-product__image">
		<img src={image} alt={title} />
		<span class="single-product__badge">
			<i class="icon-tablet single-product__badge-icon" aria-hidden="true"></i>
			<span class="single-product__badge-text">{status}</span>
		</span>
	</div>
	<div class="single-product__body">
		<div class="single-product__content">
			<div class="single-product__info">
				<h2 class="single-product__title">{title}</h2>
				<p class="single-product__ingredient">
					<span class="single-product__ingredient-label">Ingredient:</span> {description}
				</p>
			</div>
			<p class="single-product__price">{price}</p>
		</div>
		<div class="single-product__actions">
			<button
				type="button"
				class="theme-btn single-product__btn single-product__btn--outline"
				data-bs-toggle="modal"
				data-bs-target="#productDetailsModal"
			>
				Learn More
			</button>
			<button
				type="button"
				class="theme-btn theme-btn__primary single-product__btn single-product__btn--primary"
				data-bs-toggle="offcanvas"
				data-bs-target="#productStartOffcanvas"
				aria-controls="productStartOffcanvas"
			>
				Add To Cart
			</button>
		</div>
	</div>
</div>
