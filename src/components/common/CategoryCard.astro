---
const imagePath = "Themes/Thrivewellrx.Theme.EpiqScripts/assets/img";

const featuredCategories = [
	{
		title: "Weight Loss",
		image: "happy-fitness-girl.png",
		alt: "Happy fitness woman",
		sliderItems: [
			"injection-left.png",
			"progestorone.png",
			"injection-right.png",
			"injection-left.png",
			"progestorone.png",
			"injection-right.png",
			"progestorone.png",
			"injection-left.png",
			"progestorone.png",
			"injection-right.png",
		],
	},
	{
		title: "Hormone Health",
		image: "about-us.webp",
		alt: "People focused on hormone health",
		sliderItems: [
			"progestorone.png",
			"injection-left.png",
			"progestorone.png",
			"injection-right.png",
			"progestorone.png",
			"injection-left.png",
			"progestorone.png",
			"progestorone.png",
			"injection-left.png",
			"progestorone.png",
		],
	},
];
const compactCategories = [
    { 
        name: "Hair Growth", 
        image: "smiling-young-man.png" 
    },
    { 
        name: "Sexual Health", 
        image: "happy-couple.png" 
    },
    { 
        name: "Pre Workout", 
        image: "happy-working-woman.png" 
    }
];
---

<div class="category__items">
	<div class="category__intro">
		<h2>Your Wellness, Simplified. <span>Explore Our Categories.</span></h2>
		<p>
			Explore Our Product Categories To Find Everything You Need For Your
			Health And Wellness Journey. From Lab Testing Kits To Supplements.
		</p>
	</div>

	<img
		class="category__curve"
		src={`${imagePath}/curveLine.svg`}
		alt=""
		aria-hidden="true"
	/>
	<img
		class="category__hero-person"
		src={`${imagePath}/woman.png`}
		alt="Woman enjoying wellness"
	/>

	<div class="category__featured-grid">
		{
			featuredCategories.map((category) => (
				<a class="category__card category__card--featured" href="/category">
					<h3>{category.title}</h3>
						{category.sliderItems ? (
							<div class="category__product-carousel swiper" aria-hidden="true">
								<div class="swiper-wrapper">
									{category.sliderItems.map((slide) => (
										<div class="swiper-slide">
											<span class="category__product-tile">
												<img src={`${imagePath}/${slide}`} alt="" />
											</span>
										</div>
									))}
								</div>
							</div>
						) : (
							<div class="category__product-row" aria-hidden="true">
								<span class="category__product-tile category__product-tile--muted">
									<img src={`${imagePath}/progestorone.png`} alt="" />
								</span>
								<span class="category__product-tile">
									<img src={`${imagePath}/progestorone.png`} alt="" />
								</span>
								<span class="category__product-tile">
									<img src={`${imagePath}/progestorone.png`} alt="" />
								</span>
							</div>
						)}
					<span class="category__arrow" aria-label={`View ${category.title}`}>
						<i class="icon-right-arrow" />
					</span>
					<img
						class="category__card-person"
						src={`${imagePath}/${category.image}`}
						alt={category.alt}
					/>
				</a>
			))
		}
	</div>

	<div class="category__compact-grid">
		{
			compactCategories.map((category) => (
				<a class="category__card category__card--compact" href="/category">
					<img
						class="category__compact-person"
						src={`${imagePath}/${category.image}`}
						alt={category.name}
					/>
					<h4>{category.name}</h4>
					<span class="category__arrow" aria-label={`View ${category}`}>
						<i class="icon-right-arrow" />
					</span>
				</a>
			))
		}
	</div>

	<div class="category__action">
		<a class="category__view-all" href="/category">View All Categories</a>
	</div>
</div>
