<div class="container my-5 cart-shimmer">
  <!-- ========================================== -->
  <!-- CART HEADER SHIMMER                        -->
  <!-- ========================================== -->
  <div class="cart-shimmer-header text-center mb-4">
    <div class="cart-shimmer-header__title cart-shimmer-glow mx-auto mb-2">
    </div>
    <div class="cart-shimmer-header__link cart-shimmer-glow mx-auto"></div>
  </div>

  <div class="row g-4">
    <!-- Left Column: Items and Coupon -->
    <div class="col-lg-7">
      <!-- Cart Item Card Placeholder -->
      <div
        class="cart-shimmer-item mb-3 d-flex flex-column flex-sm-row align-items-center gap-3"
      >
        <!-- Product Image Frame -->
        <div
          class="cart-shimmer-item__image-wrapper flex-shrink-0 d-flex flex-column align-items-center"
        >
          <div class="cart-shimmer-item__image cart-shimmer-glow"></div>
          <div class="cart-shimmer-item__delete cart-shimmer-glow mt-2"></div>
        </div>

        <!-- Product Details -->
        <div class="flex-grow-1 w-100 text-center text-sm-start">
          <div
            class="cart-shimmer-item__name cart-shimmer-glow mb-2 mx-auto mx-sm-0"
          >
          </div>
          <div
            class="cart-shimmer-item__price cart-shimmer-glow mx-auto mx-sm-0"
          >
          </div>
        </div>

        <!-- Quantity Selector Frame -->
        <div
          class="cart-shimmer-item__quantity flex-shrink-0 cart-shimmer-glow"
        >
        </div>
      </div>

      <!-- Coupon Area Card Placeholder -->
      <div
        class="cart-shimmer-coupon d-flex flex-column flex-sm-row gap-3 align-items-center"
      >
        <div
          class="cart-shimmer-coupon__input flex-grow-1 w-100 cart-shimmer-glow"
        >
        </div>
        <div class="cart-shimmer-coupon__btn flex-shrink-0 cart-shimmer-glow">
        </div>
      </div>
    </div>

    <!-- Right Column: Summary Card -->
    <div class="col-lg-5">
      <!-- Summary Card Placeholder -->
      <div class="cart-shimmer-summary">
        <!-- Header Total Title -->
        <div class="cart-shimmer-summary__header cart-shimmer-glow mb-4"></div>

        <!-- Line Item Breakdown -->
        <div class="d-flex justify-content-between mb-3">
          <div class="cart-shimmer-summary__label cart-shimmer-glow"></div>
          <div class="cart-shimmer-summary__value cart-shimmer-glow"></div>
        </div>
        <div class="d-flex justify-content-between mb-3">
          <div class="cart-shimmer-summary__label cart-shimmer-glow"></div>
          <div class="cart-shimmer-summary__value cart-shimmer-glow"></div>
        </div>
        <div class="d-flex justify-content-between mb-4">
          <div class="cart-shimmer-summary__label cart-shimmer-glow"></div>
          <div class="cart-shimmer-summary__value cart-shimmer-glow"></div>
        </div>

        <!-- Divider -->
        <hr class="cart-shimmer-summary__divider mb-4" />

        <!-- Discount Row -->
        <div class="d-flex justify-content-between mb-3">
          <div class="cart-shimmer-summary__label cart-shimmer-glow"></div>
          <div class="cart-shimmer-summary__value cart-shimmer-glow"></div>
        </div>

        <!-- Grand Total Row -->
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div class="cart-shimmer-summary__total-label cart-shimmer-glow">
          </div>
          <div class="cart-shimmer-summary__total-value cart-shimmer-glow">
          </div>
        </div>

        <!-- Main Checkout CTA -->
        <div class="cart-shimmer-summary__btn cart-shimmer-glow"></div>
      </div>
    </div>
  </div>
</div>
