<section class="thank-you-shimmer" aria-label="Loading order confirmation" aria-busy="true">
  <div class="thank-you-shimmer__container">
    <div class="thank-you-shimmer__title thank-you-shimmer__pulse"></div>
    <div class="thank-you-shimmer__intro thank-you-shimmer__pulse"></div>

    <div class="thank-you-shimmer__next">
      <span class="thank-you-shimmer__next-line thank-you-shimmer__next-line--short thank-you-shimmer__pulse"></span>
      <span class="thank-you-shimmer__next-line thank-you-shimmer__pulse"></span>
      <span class="thank-you-shimmer__next-line thank-you-shimmer__pulse"></span>
      <span class="thank-you-shimmer__next-line thank-you-shimmer__pulse"></span>
      <span class="thank-you-shimmer__next-line thank-you-shimmer__next-line--last thank-you-shimmer__pulse"></span>
    </div>

    <div class="thank-you-shimmer__highlight">
      <span class="thank-you-shimmer__highlight-line thank-you-shimmer__highlight-line--title thank-you-shimmer__pulse"></span>
      <span class="thank-you-shimmer__highlight-line thank-you-shimmer__pulse"></span>
      <span class="thank-you-shimmer__highlight-line thank-you-shimmer__pulse"></span>
      <span class="thank-you-shimmer__highlight-line thank-you-shimmer__pulse"></span>
      <span class="thank-you-shimmer__highlight-line thank-you-shimmer__highlight-line--last thank-you-shimmer__pulse"></span>
    </div>

    <article class="thank-you-shimmer__card">
      <div class="thank-you-shimmer__card-header thank-you-shimmer__pulse"></div>
      <div class="thank-you-shimmer__info-grid">
        <div class="thank-you-shimmer__info-item"><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span></div>
        <div class="thank-you-shimmer__info-item"><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span></div>
        <div class="thank-you-shimmer__info-item"><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span></div>
        <div class="thank-you-shimmer__info-item"><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span></div>
        <div class="thank-you-shimmer__info-item"><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span></div>
        <div class="thank-you-shimmer__info-item"><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span></div>
      </div>
    </article>

    <article class="thank-you-shimmer__card thank-you-shimmer__products">
      <div class="thank-you-shimmer__card-header thank-you-shimmer__pulse"></div>
      <div class="thank-you-shimmer__product">
        <span class="thank-you-shimmer__product-image thank-you-shimmer__pulse"></span>
        <div class="thank-you-shimmer__product-info"><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span></div>
      </div>
      <div class="thank-you-shimmer__product">
        <span class="thank-you-shimmer__product-image thank-you-shimmer__pulse"></span>
        <div class="thank-you-shimmer__product-info"><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span></div>
      </div>
    </article>

    <article class="thank-you-shimmer__card thank-you-shimmer__summary">
      <div class="thank-you-shimmer__card-header thank-you-shimmer__pulse"></div>
      <div class="thank-you-shimmer__summary-grid">
        <div class="thank-you-shimmer__summary-item"><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span></div>
        <div class="thank-you-shimmer__summary-item"><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span></div>
        <div class="thank-you-shimmer__summary-item"><span class="thank-you-shimmer__label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__value thank-you-shimmer__pulse"></span></div>
      </div>
      <div class="thank-you-shimmer__total"><span class="thank-you-shimmer__total-label thank-you-shimmer__pulse"></span><span class="thank-you-shimmer__total-value thank-you-shimmer__pulse"></span></div>
    </article>

    <div class="thank-you-shimmer__actions">
      <span class="thank-you-shimmer__button thank-you-shimmer__pulse"></span>
      <span class="thank-you-shimmer__button thank-you-shimmer__button--primary thank-you-shimmer__pulse"></span>
    </div>
  </div>
</section>
