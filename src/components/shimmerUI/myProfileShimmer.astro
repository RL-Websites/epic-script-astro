<section class="my-profile-shimmer" aria-label="Loading profile" aria-busy="true">
  <div class="my-profile-shimmer__container">
    <div class="my-profile-shimmer__title my-profile-shimmer__pulse"></div>
    <div class="my-profile-shimmer__email">
      <span class="my-profile-shimmer__email-label my-profile-shimmer__pulse"></span>
      <span class="my-profile-shimmer__email-value my-profile-shimmer__pulse"></span>
    </div>

    <article class="my-profile-shimmer__form">
      <div class="my-profile-shimmer__edit my-profile-shimmer__pulse"></div>
      <div class="my-profile-shimmer__avatar my-profile-shimmer__pulse"></div>
      <div class="my-profile-shimmer__field"><span class="my-profile-shimmer__label my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__text my-profile-shimmer__pulse"></span></div>
      <div class="my-profile-shimmer__field"><span class="my-profile-shimmer__label my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__text my-profile-shimmer__pulse"></span></div>
      <div class="my-profile-shimmer__field"><span class="my-profile-shimmer__label my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__text my-profile-shimmer__pulse"></span></div>
      <div class="my-profile-shimmer__field"><span class="my-profile-shimmer__label my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__text my-profile-shimmer__pulse"></span></div>
      <div class="my-profile-shimmer__field"><span class="my-profile-shimmer__label my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__text my-profile-shimmer__pulse"></span></div>
      <div class="my-profile-shimmer__field"><span class="my-profile-shimmer__label my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__text my-profile-shimmer__pulse"></span></div>
    </article>

    <article class="my-profile-shimmer__form my-profile-shimmer__form--edit">
      <div class="my-profile-shimmer__avatar my-profile-shimmer__pulse"></div>
      <div class="my-profile-shimmer__field"><span class="my-profile-shimmer__label my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__input my-profile-shimmer__pulse"></span></div>
      <div class="my-profile-shimmer__field"><span class="my-profile-shimmer__label my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__input my-profile-shimmer__pulse"></span></div>
      <div class="my-profile-shimmer__field"><span class="my-profile-shimmer__label my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__input my-profile-shimmer__pulse"></span></div>
      <div class="my-profile-shimmer__field"><span class="my-profile-shimmer__label my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__date-inputs"><span class="my-profile-shimmer__input my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__input my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__input my-profile-shimmer__pulse"></span></span></div>
      <div class="my-profile-shimmer__field"><span class="my-profile-shimmer__label my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__radio-group"><span class="my-profile-shimmer__radio my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__radio my-profile-shimmer__pulse"></span></span></div>
      <div class="my-profile-shimmer__field"><span class="my-profile-shimmer__label my-profile-shimmer__pulse"></span><span class="my-profile-shimmer__input my-profile-shimmer__pulse"></span></div>
    </article>

    <div class="my-profile-shimmer__actions">
      <span class="my-profile-shimmer__button my-profile-shimmer__pulse"></span>
      <span class="my-profile-shimmer__button my-profile-shimmer__button--primary my-profile-shimmer__pulse"></span>
    </div>
  </div>
</section>
