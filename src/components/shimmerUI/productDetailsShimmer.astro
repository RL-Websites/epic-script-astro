<div class="container-fluid my-5">
  <!-- ========================================== -->
  <!-- CATEGORY DETAILS (HERO BANNER) SHIMMER     -->
  <!-- ========================================== -->
  <div class="product-details-shimmer mb-5">
    <div class="row align-items-center h-100 g-0">
      <!-- Left content column -->
      <div
        class="product-details-shimmer__content col-md-7 d-flex flex-column justify-content-center"
      >
        <div class="product-details-shimmer__badge shimmer-effect mb-3"></div>
        <div class="product-details-shimmer__title-line shimmer-effect mb-2">
        </div>
        <div class="product-details-shimmer__title-line shimmer-effect mb-2">
        </div>
        <div class="product-details-shimmer__title-line shimmer-effect w-75">
        </div>
      </div>
      <!-- Right image placeholder column -->
      <div class="col-md-12 h-100 position-relative d-none d-md-block">
        <div class="product-details-shimmer__image-placeholder shimmer-effect">
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- PRODUCT GRID SHIMMER                       -->
  <!-- ========================================== -->
  <section class="product-cards">
    <div class="container-fluid">
      <div class="row g-4">
        <!-- Card Item -->
        <div class="col-12 col-md-6 col-lg-4">
          <div class="product-cards-shimmer">
            <!-- Product Image Placeholder -->
            <div class="product-cards-shimmer__image-wrapper mb-3">
              <div class="product-cards-shimmer__image shimmer-effect"></div>
            </div>

            <!-- Status Badge -->
            <div class="product-cards-shimmer__badge shimmer-effect mb-3"></div>

            <!-- Title & Text Description -->
            <div class="product-cards-shimmer__title shimmer-effect mb-2"></div>
            <div class="product-cards-shimmer__text shimmer-effect mb-2"></div>
            <div class="product-cards-shimmer__text shimmer-effect w-75 mb-4">
            </div>

            <!-- CTAs (Buttons) -->
            <div class="d-flex gap-2">
              <div
                class="product-cards-shimmer__btn product-cards-shimmer__btn--primary shimmer-effect flex-grow-1"
              >
              </div>
              <div
                class="product-cards-shimmer__btn product-cards-shimmer__btn--secondary shimmer-effect flex-grow-1"
              >
              </div>
            </div>
          </div>
        </div>

        <!-- Duplicate Card 2 -->
        <div class="col-12 col-md-6 col-lg-4">
          <div class="product-cards-shimmer">
            <div class="product-cards-shimmer__image-wrapper mb-3">
              <div class="product-cards-shimmer__image shimmer-effect"></div>
            </div>
            <div class="product-cards-shimmer__badge shimmer-effect mb-3"></div>
            <div class="product-cards-shimmer__title shimmer-effect mb-2"></div>
            <div class="product-cards-shimmer__text shimmer-effect mb-2"></div>
            <div class="product-cards-shimmer__text shimmer-effect w-75 mb-4">
            </div>
            <div class="d-flex gap-2">
              <div
                class="product-cards-shimmer__btn product-cards-shimmer__btn--primary shimmer-effect flex-grow-1"
              >
              </div>
              <div
                class="product-cards-shimmer__btn product-cards-shimmer__btn--secondary shimmer-effect flex-grow-1"
              >
              </div>
            </div>
          </div>
        </div>

        <!-- Duplicate Card 3 -->
        <div class="col-12 col-md-6 col-lg-4">
          <div class="product-cards-shimmer">
            <div class="product-cards-shimmer__image-wrapper mb-3">
              <div class="product-cards-shimmer__image shimmer-effect"></div>
            </div>
            <div class="product-cards-shimmer__badge shimmer-effect mb-3"></div>
            <div class="product-cards-shimmer__title shimmer-effect mb-2"></div>
            <div class="product-cards-shimmer__text shimmer-effect mb-2"></div>
            <div class="product-cards-shimmer__text shimmer-effect w-75 mb-4">
            </div>
            <div class="d-flex gap-2">
              <div
                class="product-cards-shimmer__btn product-cards-shimmer__btn--primary shimmer-effect flex-grow-1"
              >
              </div>
              <div
                class="product-cards-shimmer__btn product-cards-shimmer__btn--secondary shimmer-effect flex-grow-1"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
