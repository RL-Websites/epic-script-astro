<div class="container-fluid my-5">
  <!-- ========================================== -->
  <!-- CATEGORY DETAILS (HERO BANNER) SHIMMER     -->
  <!-- ========================================== -->
  <div class="category-details mb-5">
    <div class="row align-items-center h-100 g-0">
      <!-- Left content column -->
      <div
        class="col-md-7 p-4 p-md-5 d-flex flex-column justify-content-center"
      >
        <div class="category-details__badge shimmer-effect mb-3"></div>
        <div class="category-details__title-line shimmer-effect mb-2"></div>
        <div class="category-details__title-line shimmer-effect mb-2"></div>
        <div class="category-details__title-line shimmer-effect w-75"></div>
      </div>
      <!-- Right image placeholder column -->
      <div class="col-md-5 h-100 position-relative d-none d-md-block">
        <div class="category-details__image-placeholder shimmer-effect"></div>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- PRODUCT GRID SHIMMER                       -->
  <!-- ========================================== -->
  <div class="row g-4">
    <!-- Card Item -->
    <div class="col-12 col-md-6 col-lg-4">
      <div class="shimmer-card">
        <!-- Product Image Placeholder -->
        <div class="shimmer-card__image-wrapper mb-3">
          <div class="shimmer-card__image shimmer-effect"></div>
        </div>

        <!-- Status Badge -->
        <div class="shimmer-card__badge shimmer-effect mb-3"></div>

        <!-- Title & Text Description -->
        <div class="shimmer-card__title shimmer-effect mb-2"></div>
        <div class="shimmer-card__text shimmer-effect mb-2"></div>
        <div class="shimmer-card__text shimmer-effect w-75 mb-4"></div>

        <!-- CTAs (Buttons) -->
        <div class="d-flex gap-2">
          <div
            class="shimmer-card__btn shimmer-card__btn--primary shimmer-effect flex-grow-1"
          >
          </div>
          <div
            class="shimmer-card__btn shimmer-card__btn--secondary shimmer-effect flex-grow-1"
          >
          </div>
        </div>
      </div>
    </div>

    <!-- Duplicate Card 2 -->
    <div class="col-12 col-md-6 col-lg-4">
      <div class="shimmer-card">
        <div class="shimmer-card__image-wrapper mb-3">
          <div class="shimmer-card__image shimmer-effect"></div>
        </div>
        <div class="shimmer-card__badge shimmer-effect mb-3"></div>
        <div class="shimmer-card__title shimmer-effect mb-2"></div>
        <div class="shimmer-card__text shimmer-effect mb-2"></div>
        <div class="shimmer-card__text shimmer-effect w-75 mb-4"></div>
        <div class="d-flex gap-2">
          <div
            class="shimmer-card__btn shimmer-card__btn--primary shimmer-effect flex-grow-1"
          >
          </div>
          <div
            class="shimmer-card__btn shimmer-card__btn--secondary shimmer-effect flex-grow-1"
          >
          </div>
        </div>
      </div>
    </div>

    <!-- Duplicate Card 3 -->
    <div class="col-12 col-md-6 col-lg-4">
      <div class="shimmer-card">
        <div class="shimmer-card__image-wrapper mb-3">
          <div class="shimmer-card__image shimmer-effect"></div>
        </div>
        <div class="shimmer-card__badge shimmer-effect mb-3"></div>
        <div class="shimmer-card__title shimmer-effect mb-2"></div>
        <div class="shimmer-card__text shimmer-effect mb-2"></div>
        <div class="shimmer-card__text shimmer-effect w-75 mb-4"></div>
        <div class="d-flex gap-2">
          <div
            class="shimmer-card__btn shimmer-card__btn--primary shimmer-effect flex-grow-1"
          >
          </div>
          <div
            class="shimmer-card__btn shimmer-card__btn--secondary shimmer-effect flex-grow-1"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
