---
const imagePath = "Themes/Thrivewellrx.Theme.EpiqScripts/assets/img";

const faqs = [
	{
		id: "faq-contact",
		question: "Contact Information For Epiq Scripts?",
		answer:
			"You can reach our support team via email or phone. Our experts are available Monday through Friday to assist with your medication and pharmacy questions.",
	},
	{
		id: "faq-started",
		question: "How Does A Patient Get Started With Epiq Scripts Pharmacy?",
		answer:
			"Choose your program, complete a brief online evaluation, and our medical team will review your profile to determine the next steps.",
	},
	{
		id: "faq-consultation",
		question:
			"Can A Patient Speak With A Pharmacist For Consultation Regarding Prescriptions? What Are The Hours Of Availability?",
		answer:
			"Yes. Licensed pharmacists are available for consultations during standard business hours, and follow-up guidance can be scheduled through the patient workflow.",
	},
	{
		id: "faq-shipping",
		question: "How Are Medications Shipped?",
		answer:
			"Medications are shipped securely and discreetly, with temperature-conscious packaging used when product handling requires it.",
	},
	{
		id: "faq-states",
		question: "What States Is Epiq Scripts Licensed In?",
		answer:
			"Licensing coverage continues to expand. Patients can confirm current availability during the sign-up and prescription flow.",
	},
];
---

<div class="faq__panel">
	<div class="faq__intro">
		<div class="faq__heading-block">
			<h2>Frequently <br> Asked Questions</h2>
		</div>

		<div class="faq__summary">
			<p>
				Through Sophisticated Software Design, We Specialize In <br> Online
				Prescription Fulfillment. Your Patient Can Order Any <br> Medication Which
				Will Then Be Sent Directly.
			</p>
		</div>
	</div>

	<div class="faq__content">
		<div class="faq__media">
			<img src={`${imagePath}/product.png`} alt="Product packaging" />
		</div>

		<div class="faq__accordion accordion" id="faqAccordionHome">
			{
				faqs.map((faq, index) => (
					<div class="faq__item accordion-item">
						<h3 class="faq__item-header accordion-header">
							<button
								class={`faq__button accordion-button${index === 0 ? "" : " collapsed"}`}
								type="button"
								data-bs-toggle="collapse"
								data-bs-target={`#${faq.id}`}
								aria-expanded={index === 0 ? "true" : "false"}
								aria-controls={faq.id}
							>
								<span class="faq__question">{faq.question}</span>
								<span class="faq__icon" aria-hidden="true"></span>
							</button>
						</h3>
						<div
							id={faq.id}
							class={`faq__collapse accordion-collapse collapse${index === 0 ? " show" : ""}`}
							data-bs-parent="#faqAccordionHome"
						>
							<div class="faq__answer accordion-body">
								<p>{faq.answer}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</div>
