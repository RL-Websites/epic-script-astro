<section class="rapid-contact my-15" id="rapid-contact">
	<div class="container-fluid">
		<div class="rapid-contact__wrapper">
			<div class="rapid-contact__title">
				<h2>Let Our Experts Help You</h2>
				<p class="text-primary">
					Tell us what you’re looking for and one of our experts will get in
					contact soon
				</p>
			</div>

			<form class="rapid-contact__form">
				<div class="row g-3">
					<div class="col-md-6">
						<div class="form-group">
							<label for="rapid-name" class="basic-label">Your Name</label>
							<input
								id="rapid-name"
								type="text"
								class="basic-input"
								placeholder="Your Name"
								required
							/>
						</div>
					</div>

					<div class="col-md-6">
						<div class="form-group">
							<label for="rapid-category" class="basic-label">
								Category of Interest
							</label>
							<div
								class="select__wrapper select__wrapper__alt custom-select"
								data-custom-select
							>
								<input
									type="hidden"
									id="rapid-category"
									name="categoryOfInterest"
									data-custom-select-input
									required
								/>
								<button
									type="button"
									class="select__options custom-select__trigger"
									data-custom-select-trigger
									aria-haspopup="listbox"
									aria-expanded="false"
								>
									<span data-custom-select-label>Category of Interest</span>
								</button>
								<ul
									class="custom-select__menu"
									data-custom-select-menu
									role="listbox"
									aria-labelledby="rapid-category"
									hidden
								>
									<li
										class="custom-select__option"
										data-value="weight-loss"
										role="option"
										aria-selected="false"
										tabindex="0"
									>
										Weight Loss
									</li>
									<li
										class="custom-select__option"
										data-value="sexual-health"
										role="option"
										aria-selected="false"
										tabindex="0"
									>
										Sexual Health
									</li>
									<li
										class="custom-select__option"
										data-value="hair-growth"
										role="option"
										aria-selected="false"
										tabindex="0"
									>
										Hair Growth
									</li>
									<li
										class="custom-select__option"
										data-value="hormone-health"
										role="option"
										aria-selected="false"
										tabindex="0"
									>
										Hormone Health
									</li>
									<li
										class="custom-select__option"
										data-value="sleep"
										role="option"
										aria-selected="false"
										tabindex="0"
									>
										Sleep
									</li>
									<li
										class="custom-select__option"
										data-value="anti-aging"
										role="option"
										aria-selected="false"
										tabindex="0"
									>
										Anti-Aging
									</li>
									<li
										class="custom-select__option"
										data-value="testosterone-replacement"
										role="option"
										aria-selected="false"
										tabindex="0"
									>
										Testosterone Replacement
									</li>
									<li
										class="custom-select__option"
										data-value="pre-workout"
										role="option"
										aria-selected="false"
										tabindex="0"
									>
										Pre-Workout
									</li>
									<li
										class="custom-select__option"
										data-value="sterile-injections"
										role="option"
										aria-selected="false"
										tabindex="0"
									>
										Sterile Injections
									</li>
								</ul>
							</div>
						</div>
					</div>

					<div class="col-md-6">
						<div class="form-group">
							<label for="rapid-company" class="basic-label">Company Name</label
							>
							<input
								id="rapid-company"
								type="text"
								class="basic-input"
								placeholder="Company Name"
							/>
						</div>
					</div>

					<div class="col-md-6">
						<div class="form-group">
							<label for="rapid-volume" class="basic-label">
								Estimated Volume
							</label>
							<input
								id="rapid-volume"
								type="text"
								class="basic-input"
								placeholder="Estimated Volume"
							/>
						</div>
					</div>

					<div class="col-md-6">
						<div class="form-group">
							<label for="rapid-email" class="basic-label">Email Address</label>
							<input
								id="rapid-email"
								type="email"
								class="basic-input"
								placeholder="Email Address"
								required
							/>
						</div>
					</div>

					<div class="col-md-6">
						<div class="form-group">
							<label for="rapid-launch" class="basic-label">
								Estimated Launch Date
							</label>
							<input
								id="rapid-launch"
								type="text"
								class="basic-input"
								placeholder="Estimated Launch Date"
							/>
						</div>
					</div>

					<div class="col-12">
						<div class="form-group">
							<label for="rapid-shipping" class="basic-label">
								Shipping Address
							</label>
							<input
								id="rapid-shipping"
								type="text"
								class="basic-input"
								placeholder="Shipping Address"
							/>
						</div>
					</div>

					<div class="col-12">
						<div class="input-group">
							<label for="textareaOne" class="basic-label"
								>Aditional Notes</label
							>
							<div class="textarea__wrapper">
								<textarea
									class="form-control"
									rows="5"
									placeholder="Additional Notes"
									name="textareaOne"
									id="textareaOne"></textarea>
								<span class="textarea__word-count">0/300</span>
							</div>
						</div>
					</div>
				</div>

				<div class="rapid-contact__action">
					<button type="submit" class="rapid-contact__submit">Submit</button>
				</div>
			</form>
		</div>
	</div>
</section>
