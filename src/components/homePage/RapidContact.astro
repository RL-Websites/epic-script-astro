<section class="rapid-contact my-10">
  <div class="container-fluid">
    <div class="rapid-contact__wrapper">
      <div class="rapid-contact__title">
        <h2>Let Our Experts Help You</h2>
        <p class="text-primary">
          Tell us what you’re looking for and one of our experts will get in
          contact soon
        </p>
      </div>

      <form class="rapid-contact__form">
        <div class="row g-3">
          <div class="col-md-6">
            <div class="form-group">
              <label for="rapid-name" class="basic-label">Your Name</label>
              <input
                id="rapid-name"
                type="text"
                class="basic-input"
                placeholder="Your Name"
                required
              />
            </div>
          </div>

          <div class="col-md-6">
            <div class="form-group">
              <label for="rapid-category" class="basic-label">
                Category of Interest
              </label>
              <input
                id="rapid-category"
                type="text"
                class="basic-input"
                placeholder="Category of Interest"
                required
              />
            </div>
          </div>

          <div class="col-md-6">
            <div class="form-group">
              <label for="rapid-company" class="basic-label">Company Name</label
              >
              <input
                id="rapid-company"
                type="text"
                class="basic-input"
                placeholder="Company Name"
              />
            </div>
          </div>

          <div class="col-md-6">
            <div class="form-group">
              <label for="rapid-volume" class="basic-label">
                Estimated Volume
              </label>
              <input
                id="rapid-volume"
                type="text"
                class="basic-input"
                placeholder="Estimated Volume"
              />
            </div>
          </div>

          <div class="col-md-6">
            <div class="form-group">
              <label for="rapid-email" class="basic-label">Email Address</label>
              <input
                id="rapid-email"
                type="email"
                class="basic-input"
                placeholder="Email Address"
                required
              />
            </div>
          </div>

          <div class="col-md-6">
            <div class="form-group">
              <label for="rapid-launch" class="basic-label">
                Estimated Launch Date
              </label>
              <input
                id="rapid-launch"
                type="text"
                class="basic-input"
                placeholder="Estimated Launch Date"
              />
            </div>
          </div>

          <div class="col-12">
            <div class="form-group">
              <label for="rapid-shipping" class="basic-label">
                Shipping Address
              </label>
              <input
                id="rapid-shipping"
                type="text"
                class="basic-input"
                placeholder="Shipping Address"
              />
            </div>
          </div>

          <div class="col-12">
            <div class="basic-wrapper">
              <label for="textareaOne" class="basic-label basic-label__alt"
                >Write down here</label
              >
              <div class="textarea__wrapper">
                <textarea
                  class="form-control"
                  rows="5"
                  placeholder=""
                  name="textareaOne"
                  id="textareaOne"></textarea>
                <span class="textarea__word-count">0/300</span>
              </div>
            </div>
          </div>
        </div>

        <div class="rapid-contact__action">
          <button type="submit" class="rapid-contact__submit">Submit</button>
        </div>
      </form>
    </div>
  </div>
</section>
