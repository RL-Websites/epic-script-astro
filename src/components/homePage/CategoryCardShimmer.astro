<div class="row g-3 category-shimmer" aria-busy="true" aria-live="polite">
  <span class="visually-hidden">Loading categories...</span>

  {Array.from({ length: 7 }).map((_, index) => (
    <div class={index < 3 ? "col-md-4" : "col-md-3"}>
      <div
        class={`category-shimmer__card category-shimmer__card--${
          index < 3 ? "large" : "small"
        }`}
        aria-hidden="true"
      >
        <div class="category-shimmer__title">
          <span class="placeholder"></span>
          {index < 3 && <span class="placeholder"></span>}
        </div>
        <div class="category-shimmer__action">
          {index < 3 && <span class="placeholder"></span>}
          <span class="placeholder category-shimmer__button"></span>
        </div>
      </div>
    </div>
  ))}
</div>
