---
const imagePath = "Themes/Thrivewellrx.Theme.EpiqScripts/assets/img";

const pharmacyCards = [
	{
		modifier: "branding",
		title: "Branding & Packaging",
		image: `${imagePath}/epiq-script-medicine.png`,
		alt: "Epiq Scripts medicine packaging",
	},
	{
		modifier: "apis",
		title: "Robusts APIs",
		image: `${imagePath}/Union.png`,
		alt: "Robust APIs illustration",
	},
	{
		modifier: "compounding",
		title: "Custom Compounding",
		image: `${imagePath}/home/pharmacy/custom-compounding.svg`,
		alt: "Custom compounding illustration",
	},
];
---

<div class="pharmacy__panel">
	<div class="pharmacy__backdrop" aria-hidden="true"></div>

	<div class="pharmacy__header">
		<h2>Smart Pharmacy Solutions</h2>
	</div>

	<div class="pharmacy__grid">
		<a class="pharmacy__card pharmacy__card--branding" href="/about">
			<div class="pharmacy__card-head">
				<h3>{pharmacyCards[0].title}</h3>
			</div>
			<div class="pharmacy__card-media pharmacy__card-media--branding">
				<img src={pharmacyCards[0].image} alt={pharmacyCards[0].alt} />
			</div>
		</a>

		<a class="pharmacy__card pharmacy__card--apis" href="/about">
			<div class="pharmacy__card-head--dark">
				<h3>{pharmacyCards[1].title}</h3>
			</div>
			<div class="pharmacy__card-media pharmacy__card-media--apis">
				<img src={pharmacyCards[1].image} alt={pharmacyCards[1].alt} />
			</div>
			<div class="pharmacy__meta">
				<span>99% Uptime</span>
				<span>Developer Friendly</span>
				<span>Always Reliable</span>
			</div>
		</a>

		<a class="pharmacy__card pharmacy__card--compounding" href="/about">
			<div class="pharmacy__card-head">
				<h3>{pharmacyCards[2].title}</h3>
			</div>
			<div class="pharmacy__card-media pharmacy__card-media--compounding">
				<video
		class="home-hero__video"
		src="Themes/Thrivewellrx.Theme.EpiqScripts/assets/video/atomicRotation.mp4"
		autoplay
		muted
		loop
		playsinline>
	</video>
			</div>
		</a>
	</div>
</div>
