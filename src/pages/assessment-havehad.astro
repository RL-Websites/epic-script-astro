---
import CommonAction from "../components/CommonAction.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout bodyClass="alt-bg">
	<Header class="site__header--border" />

	<main class="assessment__page-wrapper">
		<div class="container-lg">
			<div class="assessment assessment__alt2">
				<!-- Nav row -->
				<div class="d-flex align-items-center w-100 mb-4 assessment__nav-row">
					<div class="assessment__nav-back-wrap">
						<button onclick="" class="btn p-0 border-0 shadow-none">
							<i class="icon-back assessment__nav-back-icon"></i>
						</button>
					</div>

					<div
						class="assessment__label assessment__label__alt text-center mb-0 flex-grow-1"
					>
						Do You Have Or Have Had Any Of The Following?
					</div>

					<div class="assessment__nav-progress-wrap d-flex justify-content-end">
						<button
							class="btn p-0 border-0 shadow-none d-none d-md-flex assessment__nav-progress"
						>
							Review Progress
						</button>
					</div>
				</div>

				<!-- Assessment form -->

				<div class="assessment__form mt-30 mb-30">
					<div class="row g-3">
						<div class="col-12 col-md-6">
							<div class="form-check assessment__form__checkbox">
								<input
									class="form-check-input"
									type="checkbox"
									id="answerCheckbox1"
									value="mtc"
								/>
								<label class="form-check-label" for="answerCheckbox1"
									>Medullary Thyroid Carcinoma (MTC)</label
								>
							</div>
						</div>
						<div class="col-12 col-md-6">
							<div class="form-check assessment__form__checkbox">
								<input
									class="form-check-input"
									type="checkbox"
									id="answerCheckbox2"
									value="men2"
								/>
								<label class="form-check-label" for="answerCheckbox2"
									>Multiple Endocrine Neoplasia Type 2 (MEN2)</label
								>
							</div>
						</div>
						<div class="col-12 col-md-6">
							<div class="form-check assessment__form__checkbox">
								<input
									class="form-check-input"
									type="checkbox"
									id="answerCheckbox3"
									value="pancreatitis"
								/>
								<label class="form-check-label" for="answerCheckbox3"
									>Pancreatitis</label
								>
							</div>
						</div>
						<div class="col-12 col-md-6">
							<div class="form-check assessment__form__checkbox">
								<input
									class="form-check-input"
									type="checkbox"
									id="answerCheckbox4"
									value="kidney"
								/>
								<label class="form-check-label" for="answerCheckbox4"
									>Kidney disease</label
								>
							</div>
						</div>
						<div class="col-12 col-md-6">
							<div class="form-check assessment__form__checkbox">
								<input
									class="form-check-input"
									type="checkbox"
									id="answerCheckbox5"
									value="liver"
								/>
								<label class="form-check-label" for="answerCheckbox5"
									>Liver disease</label
								>
							</div>
						</div>
						<div class="col-12 col-md-6">
							<div class="form-check assessment__form__checkbox">
								<input
									class="form-check-input"
									type="checkbox"
									id="answerCheckbox6"
									value="gi"
								/>
								<label class="form-check-label" for="answerCheckbox6"
									>Severe GI disorders</label
								>
							</div>
						</div>
						<div class="col-12 col-md-6">
							<div class="form-check assessment__form__checkbox">
								<input
									class="form-check-input"
									type="checkbox"
									id="answerCheckbox7"
									value="retinopathy"
								/>
								<label class="form-check-label" for="answerCheckbox7"
									>Diabetic retinopathy</label
								>
							</div>
						</div>
						<div class="col-12 col-md-6">
							<div class="form-check assessment__form__checkbox">
								<input
									class="form-check-input"
									type="checkbox"
									id="answerCheckbox8"
									value="diabetes"
								/>
								<label class="form-check-label" for="answerCheckbox8"
									>Type 1 Diabetes</label
								>
							</div>
						</div>
						<div class="col-12 col-md-6">
							<div class="form-check assessment__form__checkbox">
								<input
									class="form-check-input"
									type="checkbox"
									id="answerCheckbox9"
									value="cancer"
								/>
								<label class="form-check-label" for="answerCheckbox9"
									>Active cancer (undergoing treatment)</label
								>
							</div>
						</div>
						<div class="col-12 col-md-6">
							<div class="form-check assessment__form__checkbox">
								<input
									class="form-check-input"
									type="checkbox"
									id="answerCheckbox10"
									value="eating"
								/>
								<label class="form-check-label" for="answerCheckbox10"
									>History of eating disorders</label
								>
							</div>
						</div>
						<div class="col-12 col-md-6">
							<div class="form-check assessment__form__checkbox">
								<input
									class="form-check-input"
									type="checkbox"
									id="answerCheckbox11"
									value="substance"
								/>
								<label class="form-check-label" for="answerCheckbox11"
									>History of substance abuse or addiction</label
								>
							</div>
						</div>
						<div class="col-12 col-md-6">
							<div class="form-check assessment__form__checkbox">
								<input
									class="form-check-input"
									type="checkbox"
									id="answerCheckbox12"
									value="none"
									checked
								/>
								<label class="form-check-label" for="answerCheckbox12"
									>None of the above</label
								>
							</div>
						</div>
					</div>
				</div>

				<CommonAction />
			</div>
		</div>
	</main>
</Layout>
