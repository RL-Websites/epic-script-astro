---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProductSingle from '../components/ProductSingle.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Header title="Category" />
	<main class="page">
		<div class="page__wrapper">
			<!-- category hero section start -->
			<section class="category-hero">
				<div class="container container--alt">
					<div class="category-hero__wrapper">
						<span class="status-pill status-pill--yellow-light"
							>Weight Loss</span
						>
						<h1>
							Weight loss <br /> medication online — with the experts to match.
						</h1>
					</div>
				</div>
			</section>
			<!-- category hero section ends  -->

			<!-- category slider start -->
			<section class="category-slider common__padding">
				<div class="container container--alt">
					<div class="category-slider__wrapper swiper product-swiper">
						<div class="swiper-wrapper">
							<div class="swiper-slide">
								<ProductSingle
									title="Wegovy Pen"
									description="The Comprehensive Plus Panel delivers the most in-depth health evaluation..."
									image="/Themes/Thrivewellrx.Theme.EpiqScript/assets/img/products/product-5.png"
									status="New And In Stock"
								/>
							</div>
							<div class="swiper-slide">
								<ProductSingle
									title="Sermorelin"
									description="The Comprehensive Plus Panel delivers the most in-depth health evaluation..."
									image="/Themes/Thrivewellrx.Theme.EpiqScript/assets/img/products/product-5.png"
									status="New And In Stock"
								/>
							</div>
							<div class="swiper-slide">
								<ProductSingle
									title="NAD+"
									description="The Comprehensive Plus Panel delivers the most in-depth health evaluation..."
									image="/Themes/Thrivewellrx.Theme.EpiqScript/assets/img/products/product-5.png"
									status="New And In Stock"
								/>
							</div>
							<div class="swiper-slide">
								<ProductSingle
									title="NAD+"
									description="The Comprehensive Plus Panel delivers the most in-depth health evaluation..."
									image="/Themes/Thrivewellrx.Theme.EpiqScript/assets/img/products/product-5.png"
									status="New And In Stock"
								/>
							</div>
						</div>

						<div class="category-slider__controls">
							<div class="category-slider__pagination swiper-pagination"></div>
							<div class="category-slider__navigation">
								<div class="swiper-button-prev-custom">
									<i class="icon-arrow-left"></i>
								</div>
								<div class="swiper-button-next-custom">
									<i class="icon-arrow-right"></i>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
			<!-- category slider ends  -->
		</div>
	</main>
	<Footer />
</Layout>
