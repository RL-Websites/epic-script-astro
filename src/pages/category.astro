---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProductSingle from '../components/ProductSingle.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Header title="Category" />
	<main class="page">
		<div class="page__wrapper">
			<!-- category hero section start -->
			<section class="category-hero">
				<div class="container container--alt">
					<div class="category-hero__wrapper">
						<span class="status-pill status-pill--yellow-light"
							>Weight Loss</span
						>
						<h1>
							Weight loss <br /> medication online — with the experts to match.
						</h1>
					</div>
				</div>
			</section>
			<!-- category hero section ends  -->

			<!-- category slider start -->
			<section class="category-slider common__padding">
				<div class="container container--alt">
					<div class="category-slider__wrapper">
						<div class="row">
							<div class="col-md-4">
								<ProductSingle />
							</div>
						</div>
					</div>
				</div>
			</section>
			<!-- category slider ends  -->
		</div>
	</main>
	<Footer />
</Layout>
