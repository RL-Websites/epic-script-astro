---
import Client from "../components/Client.astro";
import CategoryCard from "../components/common/CategoryCard.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Homehero from "../components/homePage/Homehero.astro";

import Layout from "../layouts/Layout.astro";
---

<Layout>
	<Header />
	<!--=====|| Main Section Start ||=====-->
	<main class="page">
		<!--===|| Banner Section Start ||===-->
		<Homehero />
		<!--===|| Banner Section End ||===-->

		<!--===|| Category Section Start ||===-->
		<section class="mb-10">
			<div class="category__home">
				<div class="container">
					<div class="category__home__wrapper">
						<CategoryCard />

						<Client />
					</div>
				</div>
			</div>
		</section>
		<!--===|| Category Section End ||===-->

		<!--===||  Solution Section Start ||===-->
		<section class="solutions mb-10">
			<div class="container">
				<div class="solutions__wrapper">
					<div class="row">
						<div class="col-md-6">
							<!-- Card 1 -->
							<div class="solutions__card solutions__card__one">
								<div class="solutions__content">
									<div class="solutions__icon">
										<i class="icon-delivery"></i>
									</div>

									<h3> End-To-End Digital Pharmacy Solutions </h3>

									<p class="solutions__text">
										Say goodbye to more telehealth app development services and
										simply integrate ready-made software into your system so you
										can offer a more joined-up service to your patients. Create
										a smooth customer journey from appointment to medication.
									</p>

									<button class="theme-btn theme-btn__primary w-auto mt-auto">
										Find Out More
									</button>
								</div>
							</div>
						</div>
						<div class="col-md-6">
							<!-- Card 2 -->
							<div class="solutions__card solutions__card__two">
								<div class="solutions__content">
									<div class="solutions__icon">
										<i class="icon-delivery"></i>
									</div>

									<h3 class="text-white"> Deliver more to your patients</h3>

									<p class="solutions__text text-white">
										Through sophisticated software design, we specialize in
										online prescription fulfillment. Your patient can order any
										medication which will then be sent directly to them with
										your business branding. We concentrate on delivering primary
										care medication that can be tailored according to the needs
										of each patient.
									</p>

									<button class="theme-btn theme-btn__primary w-auto mt-auto">
										Find Out More
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		<!--===||  Solution Section End ||===-->

		<section class="pharmacy">
			<div class="pharmacy__container">
				<!-- LEFT CONTENT -->
				<div class="pharmacy__content">
					<h1 class="pharmacy__title">
						Delivering Digital <span class="pharmacy__highlight"
							>Pharmacy Solutions</span
						>
					</h1>
				</div>

				<!-- RIGHT CARD -->
				<div class="pharmacy__card">
					<div class="card">
						<div class="card__badge">💊</div>
						<h3 class="card__title" id="card-title">
							High-Volume Prescription Fulfillment
						</h3>
					</div>
				</div>
			</div>

			<!-- SCROLL SECTIONS -->
			<div class="pharmacy__steps">
				<div class="step" data-title="High-Volume Prescription Fulfillment"
				></div>
				<div class="step" data-title="Custom Compounding"></div>
				<div class="step" data-title="Clinical Services"></div>
				<div class="step" data-title="Home Delivery"></div>
				<div class="step" data-title="Refill Automation"></div>
			</div>
		</section>

		<!-- <div class="ebook__download">
