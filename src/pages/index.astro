    <!-- FAQ section start -->
    <section class="faq my-15">
      <div class="container-fluid">
        <div class="faq__inner">
          <div class="faq__wrapper">
            <div
              class="faq__title"
              data-aos="fade-up"
              data-aos-delay="400"
              data-aos-duration="600"
            >
              <h2 class="faq__heading">
                Frequently <br /><span>Asked Questions</span>
              </h2>
            </div>
            <!-- faq accordion start -->
            <div
              class="faq__accordion accordion accordion-flush"
              id="faqAccordion"
              data-aos="fade-up"
              data-aos-delay="400"
              data-aos-duration="600"
            >
              <div class="accordion-item faq__item">
                <h2 class="accordion-header">
                  <button
                    class="accordion-button faq__button"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-1"
                    aria-expanded="true"
                    aria-controls="faq-1"
                  >
                    <span class="faq__accordion-title"
                      >Contact Information For Epiq Scripts?</span
                    >
                  </button>
                </h2>
                <div
                  id="faq-1"
                  class="accordion-collapse collapse show"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body faq__body">
                    You can reach our support team via email or phone. Our
                    experts are available Monday through Friday to assist with
                    your weight loss journey and medication questions.
                  </div>
                </div>
              </div>

              <div class="accordion-item faq__item">
                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed faq__button"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-2"
                    aria-expanded="false"
                    aria-controls="faq-2"
                  >
                    <span class="faq__accordion-title"
                      >How Does A Patient Get Started With Epiq Scripts
                      Pharmacy?</span
                    >
                  </button>
                </h2>
                <div
                  id="faq-2"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body faq__body">
                    Getting started is simple. Choose your program, complete a
                    brief online evaluation, and our medical team will review
                    your health profile to determine the best treatment plan for
                    you.
                  </div>
                </div>
              </div>

              <div class="accordion-item faq__item">
                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed faq__button"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-3"
                    aria-expanded="false"
                    aria-controls="faq-3"
                  >
                    <span class="faq__accordion-title"
                      >Can A Patient Speak With A Pharmacist For Consultation
                      Regarding Prescriptions? What Are The Hours Of
                      Availability?</span
                    >
                  </button>
                </h2>
                <div
                  id="faq-3"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body faq__body">
                    Yes, our licensed pharmacists are available for
                    consultations. You can schedule a call through your patient
                    dashboard during our standard business hours.
                  </div>
                </div>
              </div>

              <div class="accordion-item faq__item">
                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed faq__button"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-4"
                    aria-expanded="false"
                    aria-controls="faq-4"
                  >
                    <span class="faq__accordion-title"
                      >How Are Medications Shipped?</span
                    >
                  </button>
                </h2>
                <div
                  id="faq-4"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body faq__body">
                    All medications are shipped discreetly and securely to your
                    preferred address. We use temperature-controlled packaging
                    where necessary to ensure product integrity.
                  </div>
                </div>
              </div>

              <div class="accordion-item faq__item">
                <h2 class="accordion-header">
                  <button
                    class="accordion-button collapsed faq__button"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#faq-5"
                    aria-expanded="false"
                    aria-controls="faq-5"
                  >
                    <span class="faq__accordion-title"
                      >What States Is Epiq Scripts Licensed In?</span
                    >
                  </button>
                </h2>
                <div
                  id="faq-5"
                  class="accordion-collapse collapse"
                  data-bs-parent="#faqAccordion"
                >
                  <div class="accordion-body faq__body">
                    We are currently licensed in a majority of states and are
                    constantly expanding our reach. Please check our
                    availability during the sign-up process.
                  </div>
                </div>
              </div>
            </div>
            <!-- faq accordion ends  -->
          </div>

          <!-- Future Healthcare Section Start -->
          <div class="future-healthcare">
            <div class="future-healthcare__wrapper">
              <div class="row align-items-center">
                <div class="col-lg-8">
                  <div
                    class="future-healthcare__content"
                    data-aos="fade-up-right"
                    data-aos-delay="400"
                    data-aos-duration="600"
                  >
                    <h2 class="future-healthcare__heading">
                      Ready To Welcome <br />
                      In The Future Of Healthcare?
                    </h2>
                    <h4 class="future-healthcare__sub-heading">
                      We Rx-Cited To Hear From You
                    </h4>
                    <a href="#rapid-contact" class="theme-btn theme-btn__white">
                      Contact Us
                    </a>
                  </div>
                </div>
                <div class="col-lg-4 mt-0 mt-md-30">
                  <div
                    class="future-healthcare__img"
                    data-aos="fade-up-left"
                    data-aos-delay="400"
                    data-aos-duration="600"
                  >
                    <img
                      src="Themes/Thrivewellrx.Theme.EpiqScripts/assets/img/healthcare-img.png"
                      alt="Healthcare tablets"
                    />
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- Future Healthcare Section end -->
        </div>
      </div>
    </section>
    <!-- FAQ section ends  -->
    <section class="client-section">
      <Client />
    </section>
  </main>
  <!--=====|| Main Section End ||=====-->

  <Footer />
