    <!--===||  Technology, Shipment, Packaging Section Start ||===-->
    <section class="tsp">
      <div class="container-fluid">
        <div class="tsp__wrapper">
          <div class="tsp__block">
            <div class="row tsp__block__row">
              <div
                class="col-md-6"
                data-aos="fade-up-right"
                data-aos-delay="200"
                data-aos-duration="500"
              >
                <div class="tsp__block__img">
                  <img
                    src="Themes/Thrivewellrx.Theme.EpiqScripts/assets/img/home/technology.png"
                    alt="Technology"
                  />
                </div>
              </div>
              <div
                class="col-md-6"
                data-aos="fade-up-left"
                data-aos-delay="200"
                data-aos-duration="500"
              >
                <div class="tsp__block__content pl-md-30 mt-md-0 mt-20">
                  <h2>Technology that connects</h2>
                  <h2 class="text-cyan2">every step of care</h2>
                  <p class="fs-md-20 fs-16 mt-10">
                    Epiq Connect brings prescribing, fulfillment, and patient
                    management into one seamless system. From order submission
                    to delivery, providers have real-time visibility into every
                    step—reducing friction and simplifying operations.
                  </p>
                  <button class="theme-btn theme-btn__primary w-auto mt-20">
                    Explore Options
                  </button>
                </div>
              </div>
            </div>
          </div>
          <div class="my-md-80 my-30 px-md-60 px-20">
            <div class="dashed-border"></div>
          </div>
          <div class="tsp__block">
            <div class="row tsp__block__row">
              <div
                class="col-md-6 order-md-1 order-2"
                data-aos="fade-up-right"
                data-aos-delay="200"
                data-aos-duration="500"
              >
                <div class="tsp__block__content pl-md-30 mt-md-0 mt-20">
                  <h2>Reliable Shipment</h2>
                  <h2 class="text-cyan2">and Delivery</h2>
                  <p class="fs-md-20 fs-16 mt-10">
                    Epiq Scripts can deliver your patient’s medication quickly
                    and efficiently. Our online prescription fulfillment service
                    is available across the US and our pharmacy experience
                    ensures we can manage and expedite large-scale ordering as
                    your business grows.
                  </p>
                  <button class="theme-btn theme-btn__primary w-auto mt-20">
                    Explore Options
                  </button>
                </div>
              </div>

              <div
                class="col-md-6 order-md-2 order-1"
                data-aos="fade-up-left"
                data-aos-delay="200"
                data-aos-duration="500"
              >
                <div class="tsp__block__img pl-md-50">
                  <img
                    src="Themes/Thrivewellrx.Theme.EpiqScripts/assets/img/home/shipment.png"
                    alt="Technology"
                  />
                </div>
              </div>
            </div>
          </div>
          <div class="my-md-80 my-30 px-md-60 px-20">
            <div class="dashed-border"></div>
          </div>

          <div class="tsp__block">
            <div class="row tsp__block__row">
              <div
                class="col-md-6"
                data-aos="fade-up-right"
                data-aos-delay="200"
                data-aos-duration="500"
              >
                <div class="tsp__block__img">
                  <img
                    src="Themes/Thrivewellrx.Theme.EpiqScripts/assets/img/home/packaging.png"
                    alt="Technology"
                  />
                </div>
              </div>
              <div
                class="col-md-6"
                data-aos="fade-up-left"
                data-aos-delay="200"
                data-aos-duration="500"
              >
                <div class="tsp__block__content pl-md-30 mt-md-0 mt-20">
                  <h2>Packaging that fits</h2>
                  <h2 class="text-cyan2">your BRAND</h2>
                  <p class="fs-md-20 fs-16 mt-10">
                    Choose from a range of formats, materials, and
                    configurations tailored to your product, workflow, and
                    volume. So you can launch faster and scale with confidence.
                  </p>
                  <button class="theme-btn theme-btn__primary w-auto mt-20">
                    Explore Options
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!--===||  Technology, Shipment, Packaging Section End ||===-->

    <!--===||  Features Section Start ||===-->
