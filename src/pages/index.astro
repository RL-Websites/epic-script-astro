---
import Client from "../components/Client.astro";
import CategoryCard from "../components/common/CategoryCard.astro";
import CategoryCardShimmer from "../components/homePage/CategoryCardShimmer.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Homehero from "../components/homePage/Homehero.astro";
import RapidContact from "../components/homePage/RapidContact.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Header />
  <!--=====|| Main Section Start ||=====-->
  <main class="page">
    <!--===|| Banner Section Start ||===-->
    <Homehero />
    <!--===|| Banner Section End ||===-->

    <!--===|| Category Section Start ||===-->
    <CategoryCardShimmer />
    <section class="mb-15">
      <div class="category__home">
        <div class="container-fluid">
          <div class="category__home__wrapper">
            <div
              class="category__home__title"
              data-aos="fade-up"
              data-aos-delay="400"
              data-aos-duration="600"
            >
              <h2>Try Our Epiq Scripts Catalog</h2>
              <p class="text-primary">
                Contact us to learn more about our offerings!
              </p>
            </div>
            <CategoryCard />
            <!-- <CategoryCardShimmer /> -->
          </div>
        </div>
      </div>
    </section>
    <!--===|| Category Section End ||===-->

    <!--===|| Rapid Contact Section Start ||===-->
    <RapidContact />
    <!--===|| Rapid Contact Section End ||===-->

    <!--===||  Solution Section Start ||===-->
