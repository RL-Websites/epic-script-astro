---
import CommonAction from "../components/CommonAction.astro";
import FileUpload from "../components/FileUpload.astro";
import Header from "../components/Header.astro";
import NoFileUpload from "../components/NoFileUpload.astro";
import Layout from "../layouts/Layout.astro";

const documents = Array.from({ length: 3 });
---

<Layout>
	<Header />

	<main class="upload-licence">
		<section class="upload-licence__content mt-150">
			<h1 class="upload-licence__title">Verify Your Identity</h1>

			<!-- Upload Licence Photo Start -->
			<div class="upload-licence__photo">
				<h1 class="upload-licence__subtitle">
					<span class="numaric">1</span>
					Upload licence photo
				</h1>

				<div class="upload-licence__warning">
					<div class="upload-licence__warning_container">
						<p>
							Please upload a clear photo of the front and back of your driver’s
							license or government-issued ID using the uploader below. <br /> After
							uploading, use the drop-down menu to label which side is which.
						</p>
					</div>
				</div>

				<div class="row g-4">
					<div class="col-md-6">
						<p class="upload-licence__subtitle">Front of license</p>
						<FileUpload />
					</div>
					<div class="col-md-6">
						<p class="upload-licence__subtitle">Back of license</p>
						<FileUpload />
					</div>
				</div>

				<aside class="upload-licence__notice mt-20">
					<i class="icon-info-circle upload-licence__notice-icon"></i>
					<div class="upload-licence__notice_container">
						<p class="upload-licence__notice__text">
							<span>Mandatory Files to Upload:</span> You have to upload these mandatory
							documents.
						</p>
					</div>
				</aside>
			</div>
			<!-- Upload Licence Photo Start -->

			<div class="border my-30"></div>

			<!-- Upload Licence Lab Report Upload -->
			<div class="upload-licence__reports mt-30">
				<h1 class="upload-licence__subtitle">
					<span class="numaric">2</span>
					Upload Lab Report
				</h1>
				<div class="upload-licence__cards">
					<FileUpload />
					<NoFileUpload />
				</div>

				<aside class="upload-licence__notice mt-20">
					<i class="icon-info-circle upload-licence__notice-icon"></i>
					<div class="upload-licence__notice_container">
						<p class="upload-licence__notice__text">
							<span>Mandatory Files to Upload:</span> You can skip this process by
							clicking on save, but you will have to upload these mandatory documents
							later.
						</p>
					</div>
				</aside>
			</div>
			<!-- Upload Licence Lab Report Upload -->

			<!-- Upload Licence Lab Report Uploaded -->
			<div class="upload-licence__reports mt-30">
				<h1 class="upload-licence__subtitle">
					<span class="numaric">2</span>
					Upload Lab Report
				</h1>
				<div class="upload-licence__cards">
					<FileUpload />
					<div
						class="upload-licence__documents"
						aria-label="Uploaded documents"
					>
						{
							documents.map(() => (
								<div class="upload-licence__document">
									<div class="upload-licence__document-info">
										<i class="icon-attachment upload-licence__document-icon" />
										<div>
											<p class="upload-licence__document-name">
												Dylans Prescription.pdf
											</p>
											<div class="upload-licence__document-status">
												<span>90 KB of 90 KB</span>
												<i class="icon-ellipse" />
												<span>
													<i class="icon-completed" />
													Completed
												</span>
											</div>
										</div>
									</div>
									<button
										class="upload-licence__delete"
										type="button"
										aria-label="Remove Dylans Prescription.pdf"
									>
										<i class="icon-delete" />
									</button>
									<label class="upload-licence__select">
										<span class="upload-licence__sr-only">Document type</span>
										<select>
											<option value="prescription">
												Driving license back part
											</option>
											<option value="report">Driving license back part</option>
										</select>
									</label>
								</div>
							))
						}
					</div>
				</div>

				<aside class="upload-licence__notice mt-20">
					<i class="icon-info-circle upload-licence__notice-icon"></i>
					<div class="upload-licence__notice_container">
						<p class="upload-licence__notice__text">
							<span>Mandatory Files to Upload:</span> You can skip this process by
							clicking on save, but you will have to upload these mandatory documents
							later.
						</p>
					</div>
				</aside>
			</div>
			<!-- Upload Licence Lab Report Uploaded -->
		</section>

		<!-- <footer class="upload-licence__actions">
      <a class="upload-licence__action upload-licence__action--back" href="#"
        >Go Back</a
      >
      <button
        class="upload-licence__action upload-licence__action--save"
        type="button">Save</button
      >
    </footer> -->

		<CommonAction />
	</main>
</Layout>
