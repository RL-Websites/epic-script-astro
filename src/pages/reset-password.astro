---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<Header />

	<main class="page">
		<section class="reset-password login">
			<div class="container p-0">
				<form>
					<div class="container">
						<div class="row justify-content-center mx-0">
							<div
								class="col-lg-6 d-flex align-items-center justify-content-center"
							>
								<div class="login__content">
									<div
										class="login__header text-center mb-30"
										data-aos="fade-up"
										data-aos-duration="1000"
									>
										<div
											class="col-12 text-center"
											data-aos="fade-down"
											data-aos-duration="1000"
											data-aos-delay="100"
										>
											<h1 class="text-primary-grad-1 mb-0">Reset Password</h1>
										</div>
									</div>
									<!-- Container with consistent spacing -->
									<div class="d-flex flex-column gap-24">
										<!-- Email Display -->
										<div
											class="mb-4"
											data-aos="fade-up"
											data-aos-duration="1000"
											data-aos-delay="300"
										>
											<div class="basic-wrapper">
												<label for="email" class="basic-label"
													>Email Address</label
												>
												<input
													type="email"
													class="basic-input d basic-input__alt"
													placeholder="John_07@gmail.com"
													readonly
												/>
											</div>
										</div>

										<div
											class="form-group mb-0"
											data-aos="fade-up"
											data-aos-duration="1000"
											data-aos-delay="400"
										>
											<div class="basic-wrapper">
												<label for="password" class="basic-label"
													>New Password:</label
												>
												<div class="login__password">
													<input
														id="new_password"
														type="password"
														name="new_password"
														placeholder="Enter New Password"
														required=""
														class="basic-input login__input"
													/>

													<button type="button" class="login__toggle-btn">
														<i class="icon-state-on"></i>
														<!-- <i class="icon-password-encrypt"></i> -->
													</button>
												</div>
											</div>
											<p class="basic-error">Password is required</p>
										</div>

										<div
											class="form-group mb-0"
											data-aos="fade-up"
											data-aos-duration="1000"
											data-aos-delay="500"
										>
											<div class="basic-wrapper">
												<label for="password" class="basic-label"
													>Confirm Password:</label
												>
												<div class="login__password">
													<input
														id="confirm_password"
														type="password"
														name="confirm_password"
														placeholder="Confirm New Password"
														required=""
														class="basic-input login__input"
													/>
													<button type="button" class="login__toggle-btn">
														<i class="icon-state-off"></i>
														<!-- <i class="icon-password-encrypt"></i> -->
													</button>
												</div>
											</div>
											<p class="basic-error">Confirm Password is required!</p>
										</div>

										<!-- Submit Button and Links -->
										<div
											class="floating__buttons__items floating__buttons__items__alt"
										>
											<button
												class="theme-btn theme-btn__outline theme-btn__outline--primary"
												data-bind="click:goToHome"
											>
												Begin your journey
											</button>
											<button
												class="theme-btn theme-btn__primary text-center"
												data-bind="click:loadPartialShippingView"
											>
												Login
											</button>
										</div>
										<!-- <div
											class="d-flex flex-column gap-3"
											data-aos="flip-left"
											data-aos-duration="1000"
											data-aos-delay="600">
											<button
												type="submit"
												class="theme-btn theme-btn__primary w-100 btn-lg py-10">
												Change Password
											</button>

											<div
												class="text-center"
												data-aos="fade-up"
												data-aos-duration="1000"
												data-aos-delay="700">
												<p class="mb-2">
													Already have an account?
													<button
														class="text-decoration-underline ms-1 theme-btn theme-btn__accent text-primary">
														Log In
													</button>
												</p>
												<p class="mb-0 mb-60">
													First-time Visitor?
													<button
														class="text-decoration-underline fw-medium ms-1 theme-btn theme-btn__accent text-primary">
														Create an account
													</button>
												</p>
											</div>
										</div> -->
									</div>
								</div>
							</div>
							<!-- Image Column -->
							<div class="col-lg-6 d-none d-lg-block p-3">
								<div class="login__image w-100">
									<img
										src="/Themes/Thrivewellrx.Theme.EpiqScripts/assets/img/bg/reset-bg.jpg"
										alt="Login Background"
									/>
								</div>
							</div>
						</div>
					</div>
				</form>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
