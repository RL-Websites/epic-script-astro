---
import CommonAction from "../components/CommonAction.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout bodyClass="alt-bg">
	<Header class="site__header--border" />

	<main class="assessment__page-wrapper">
		<div class="container">
			<div class="assessment">
				<!--Assesment Header Start -->
				<!-- <AssesmentHeader /> -->
				<!--Assesment Header End -->

				<!-- Assessment form start -->
				<div class="assessment__form all-questions">
					<div class="single-question">
						<label class="assessment__label"> And your first name? </label>
						<div class="basic-wrapper">
							<label class="basic-label" for="firstName"
								>First name <span class="icon-ellipse"></span></label
							>
							<input
								class="basic-input"
								type="text"
								name="firstName"
								id="firstName"
								placeholder=" "
							/>
						</div>
					</div>
					<div class="single-question">
						<label class="assessment__label"> And your last name? </label>
						<div class="basic-wrapper">
							<label class="basic-label" for="lastName"
								>Last name <span class="icon-ellipse"></span></label
							>
							<input
								class="basic-input"
								type="text"
								name="lastName"
								id="lastName"
								placeholder=" "
							/>
						</div>
					</div>
					<div class="single-question">
						<label class="assessment__label">
							Could you provide your email address?
						</label>
						<div class="basic-wrapper">
							<label class="basic-label" for="email"
								>Email address <span class="icon-ellipse"></span></label
							>
							<input
								class="basic-input"
								type="text"
								name="email"
								id="email"
								placeholder=" "
							/>
						</div>
					</div>
					<div class="single-question">
						<label class="assessment__label">
							Phone number to reach you, not for marketing
						</label>
						<div class="basic-wrapper">
							<label class="basic-label" for="phone"
								>Phone number <span class="icon-ellipse"></span></label
							>
							<input
								class="basic-input"
								type="text"
								name="phone"
								id="phone"
								placeholder=" "
							/>
						</div>
					</div>
				</div>
				<!-- Assessment form end -->
				<!-- Assessment buttons start -->
				<CommonAction />
				<!-- Assessment buttons end -->
			</div>
		</div>
		<!--Footer Section end-->
		<!-- <AssesmentFooter /> -->
	</main>
</Layout>
