---
import AssesmentHeader from "../components/AssesmentHeader.astro";
import CommonAction from "../components/CommonAction.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<!-- Header Start -->
	<Header />
	<!-- Header End -->
	<div class="assessment__page-wrapper">
		<div class="container">
			<div class="assessment">
				<!--Assesment Header Start -->
				<AssesmentHeader />
				<!--Assesment Header End -->

				<!-- Assessment question title start -->
				<div class="assessment__question">
					Please provide details about your confidence level at work to help us
					understand your current health status.
				</div>
				<!-- Assessment question title end -->

				<!-- Assessment form start -->
				<div class="assessment__form all-questions">
					<div class="single-question">
						<label class="assessment__label">
							How much decline in your work performance have you noticed?
						</label>
						<input type="text" class="form-control" placeholder="Write here" />
					</div>
					<div class="single-question">
						<label class="assessment__label"> And when did it start? </label>
						<input type="text" class="form-control" placeholder="Write here" />
					</div>
				</div>
				<!-- Assessment form end -->
			</div>
		</div>
	</div>

	<!-- Assessment buttons start -->
	<CommonAction />
	<!-- Assessment buttons end -->
</Layout>
