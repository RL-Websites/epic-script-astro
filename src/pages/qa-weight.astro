---
import CommonAction from "../components/CommonAction.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout bodyClass="alt-bg">
	<Header class="site__header--border" />
	<div class="assessment__page-wrapper">
		<div class="container">
			<div class="assessment mb-80">
				<!--Assesment Header Start -->
				<!-- <AssesmentHeader /> -->
				<!--Assesment Header End -->

				<!-- Assessment question sub title start -->
				<div class="d-flex justify-content-center w-100">
					<img
						class="newcustomer-mobile-img"
						src="Themes/Thrivewellrx.Theme.EpiqScripts/assets/img/newcustomer_female.png"
					/>
				</div>
				<div class="assessment__label mt-40">
					What Is Your Current Weight?
				</div>
				<!-- Assessment question sub title end -->
				<div class="assessment__form mt-30">
					<div class="measurement">
						<div class="measurement-input">
							<input
								type="text"
								class="form-control"
								placeholder="0"
								aria-describedby="basic-addon2"
							/>
							<span class="unit">lbs</span>
						</div>
					</div>
				</div>
				<!-- Single Assessment form end -->

				<!-- Assessment buttons start -->
				<CommonAction />
			</div>
		</div>

		<!--Footer Section end-->
		<!-- <AssesmentFooter /> -->
	</div>
</Layout>
