---
import Layout from "../layouts/Layout.astro";
import ProductDetailsShimmer from "../components/shimmerUI/productDetailsShimmer.astro";
import CartShimmer from "../components/shimmerUI/cartShimmer.astro";
import CategoryCardShimmer from "../components/shimmerUI/CategoryCardShimmer.astro";
import PaymentMethodShimmer from "../components/shimmerUI/paymentMethod.astro";
import MyOrderShimmer from "../components/shimmerUI/myOrderShimmer.astro";
import OrderDetailsShimmer from "../components/shimmerUI/orderDetailsShimmer.astro";
---

<Layout bodyClass="shimmerUI container-fluid">
  <main class="">
    <h1>Category Card Shimmer</h1>
    <CategoryCardShimmer />
    <h1>Product Details Shimmer</h1>
    <ProductDetailsShimmer />
    <h1>Cart Shimmer</h1>
    <CartShimmer />
    <h1>Payment Method Shimmer</h1>
    <PaymentMethodShimmer />
    <h1>My Order Shimmer</h1>
    <MyOrderShimmer />
    <h1>Order Details Shimmer</h1>
    <OrderDetailsShimmer />
  </main>
</Layout>
