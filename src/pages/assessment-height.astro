---
import CommonAction from "../components/CommonAction.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout bodyClass="alt-bg">
	<Header class="site__header--border" />

	<main class="assessment__page-wrapper">
		<div class="container-lg">
			<div class="assessment assessment__alt">
				<!-- Nav row -->
				<div class="d-flex align-items-center w-100 mb-4 assessment__nav-row">
					<div class="assessment__nav-back-wrap">
						<button onclick="" class="btn p-0 border-0 shadow-none">
							<i class="icon-back assessment__nav-back-icon"></i>
						</button>
					</div>

					<div
						class="assessment__label assessment__label__alt text-center mb-0 flex-grow-1"
					>
						What Is Your Current Height?
					</div>

					<div class="assessment__nav-progress-wrap d-flex justify-content-end">
						<button
							class="btn p-0 border-0 shadow-none d-none d-md-flex assessment__nav-progress"
						>
							Review Progress
						</button>
					</div>
				</div>

				<!-- Assessment form -->
				<div class="assessment__form mt-20">
					<div class="measurement">
						<div class="measurement-input">
							<input type="text" class="form-control" placeholder="0" />
							<span class="unit">Feet</span>
						</div>
						<div class="measurement-input mt-md-20 mt-15">
							<input type="text" class="form-control" placeholder="0" />
							<span class="unit">Inch</span>
						</div>
					</div>
				</div>

				<CommonAction />
			</div>
		</div>
	</main>
</Layout>
