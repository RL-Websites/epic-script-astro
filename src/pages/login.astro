---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<Header />

	<!-- =====|| Main Section Start ||====== -->
	<main class="page">
		<!-- ==|| Login Section Start ||== -->
		<section class="login">
			<div class="container-fluid">
				<div class="row">
					<!--  Column -->
					<div
						class="col-lg-6 d-flex align-items-center justify-content-center"
					>
						<div class="login__content">
							<div class="login__header">
								<div
									class="col-12"
									data-aos="fade-down"
									data-aos-duration="1000"
									data-aos-delay="100"
									data-aos-once="true"
								>
									<h2>Returning customer</h2>
								</div>

								<div
									class="col-12 mb-5"
									data-aos="fade-down"
									data-aos-duration="1000"
									data-aos-delay="200"
									data-aos-once="true"
								>
									<h3>Log in to continue your journey</h3>
								</div>
							</div>

							<form class="login__form">
								<div
									data-aos="fade-up"
									data-aos-duration="1000"
									data-aos-delay="300"
									data-aos-once="true"
								>
									<div class="basic-wrapper">
										<label for="email" class="basic-label">
											Email Address <span class="icon-ellipse"> </span></label
										>
										<input
											type="email"
											class="basic-input login__input"
											placeholder=""
											id="email"
											required
										/>
									</div>
									<p class="basic-error">Email Address is required</p>
								</div>

								<div
									data-aos="fade-up"
									data-aos-duration="1000"
									data-aos-delay="400"
									data-aos-once="true"
								>
									<div class="basic-wrapper">
										<label for="password" class="basic-label">
											Password<span class="icon-ellipse"> </span></label
										>
										<div class="login__password">
											<input
												type="password"
												class="basic-input login__input"
												placeholder=""
												id="password"
												required
											/>
											<button type="button" class="login__toggle-btn">
												<i class="icon-state-on"></i>
											</button>
										</div>
									</div>
									<p class="basic-error">Password required</p>
								</div>

								<div class="d-flex justify-content-between align-items-center">
									<div
										class="d-flex gap-2 align-items-center"
										data-aos="fade-up"
										data-aos-duration="1000"
										data-aos-delay="500"
										data-aos-once="true"
									>
										<input
											class="form-check-input"
											type="checkbox"
											id="remember"
											checked
										/>
										<label class="basic-label" for="remember">
											Remember me
										</label>
									</div>
									<a
										href="#"
										class="first-time-text mb-0"
										data-aos="fade-up"
										data-aos-duration="1000"
										data-aos-delay="500"
										data-aos-once="true"
									>
										Forgot your password?
									</a>
								</div>

								<!-- <div
									data-aos="flip-left"
									data-aos-duration="1000"
									data-aos-delay="600"
									data-aos-once="true"
									class="d-none d-md-block"
								>
									<button
										type="submit"
										class="theme-btn theme-btn__primary theme-btn__min-w-100 w-100 btn-lg"
									>
										Login
									</button>
									<button
										type="submit"
										class="theme-btn theme-btn-size-md theme-btn__outline theme-btn__outline--primary"
									>
										Begin Your Journey
									</button>
								</div> -->

								<div
									class="floating__buttons__items floating__buttons__items__alt"
								>
									<button
										class="theme-btn theme-btn__outline theme-btn__outline--primary"
										data-bind="click:goToHome"
									>
										Begin your journey
									</button>
									<button
										class="theme-btn theme-btn__primary text-center"
										data-bind="click:loadPartialShippingView"
									>
										Login
									</button>
								</div>
							</form>
						</div>
					</div>

					<!-- Image Column -->
					<div class="col-lg-6 d-none d-lg-block p-3">
						<div class="login__image w-100">
							<img
								src="/Themes/Thrivewellrx.Theme.EpiqScripts/assets/img/bg/login-bg.jpg"
								alt="Login Background"
							/>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
