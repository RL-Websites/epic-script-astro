---
interface Props {
	bodyClass?: string;
}

const { bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="viewport" content="initial-scale = 1.0,maximum-scale = 1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css"
		/>
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css"
		/>
		<link
			rel="stylesheet"
			href="Themes/Thrivewellrx.Theme.EpiqScript/assets/vendors/swiper/package/swiper-bundle.min.css"
		/>
		<link
			rel="stylesheet"
			href="Themes/Thrivewellrx.Theme.EpiqScript/assets/vendors/aos/aos.css"
		/>
		<!-- <link
			rel="stylesheet"
			href="Themes/Thrivewellrx.Theme.EpiqScript/assets/vendors/bootstrap-datetimepicker/bootstrap-datetimepicker.css"
		/> -->
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/vanillajs-datepicker@1.3.4/dist/css/datepicker.min.css"
		/>
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/vanillajs-datepicker@1.3.4/dist/css/datepicker-bs5.min.css"
		/>
		<link
			rel="stylesheet"
			href="Themes/Thrivewellrx.Theme.EpiqScript/assets/icons/style.css"
		/>
		<link
			rel="stylesheet"
			href="Themes/Thrivewellrx.Theme.EpiqScript/assets/css/style.css"
		/>
	</head>
	<body class={bodyClass}>
		<slot />
		<!-- =====|| All JS Integration Start Here ||===== -->

		<script
			src="Themes/Thrivewellrx.Theme.EpiqScript/assets/vendors/jquery/jquery.3.3.1.js"
			defer></script>

		<script
			src="Themes/Thrivewellrx.Theme.EpiqScript/assets/vendors/bootstrap/js/bootstrap.bundle.min.js"
			defer></script>
		<script
			src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js"
			defer></script>
		<script
			src="Themes/Thrivewellrx.Theme.EpiqScript/assets/vendors/moment/moment.js"
			defer></script>

		<script
			src="Themes/Thrivewellrx.Theme.EpiqScript/assets/vendors/swiper/package/swiper-bundle.min.js"
			defer></script>
		<!-- <script
			src="Themes/Thrivewellrx.Theme.EpiqScript/assets/vendors/bootstrap-datetimepicker/bootstrap-datetimepicker.min.js"
			defer></script> -->

		<!-- DatePicker JS -->
		<script
			src="https://cdn.jsdelivr.net/npm/vanillajs-datepicker@1.3.4/dist/js/datepicker-full.min.js"
			defer></script>

		<script src="Themes/Thrivewellrx.Theme.EpiqScript/assets/js/aos.js" defer
		></script>
		<script src="Themes/Thrivewellrx.Theme.EpiqScript/assets/js/slider.js" defer
		></script>
		<script
			src="Themes/Thrivewellrx.Theme.EpiqScript/assets/js/datepicker.js"
			defer></script>
		<script src="Themes/Thrivewellrx.Theme.EpiqScript/assets/js/main.js" defer
		></script>

		<!-- =====|| All JS Integration End Here ||===== -->
	</body>
</html>
